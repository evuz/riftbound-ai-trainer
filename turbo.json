{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "dependsOn": ["^clean"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["**/*.ts", ".oxlintrc.json"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["**/*.spec.ts", "**/*.test.ts", "vitest.config.ts"]
    }
  }
}
